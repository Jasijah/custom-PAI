# Core gateway runtime
GATEWAY_PORT=18789
GATEWAY_BIND=127.0.0.1

# Workspace + app state (use absolute paths for reliability)
# Windows example: C:\\Users\\you\\clawd
# macOS example: /Users/you/clawd
CLAWDIS_WORKSPACE=
CLAWDIS_STATE_DIR=

# Miya Personal AI feature toggles
MIYA_ENABLED=0
MIYA_ENCRYPTION_KEY=replace-with-32-byte-key

# Provider setup
# Recommended first run:
#   pnpm clawdis onboard
# Or, if you already have an Anthropic key:
#   pnpm clawdis configure
# The onboarding flow stores provider credentials in Clawdis-managed auth storage.
# Keep secrets out of this file unless you explicitly want env-based auth for local experiments.

# Logging
LOG_LEVEL=info
